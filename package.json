{
	"name": "@touchspot/prettier-config",
	"version": "3.0.3",
	"homepage": "https://github.com/touchspot/prettier-config#readme",
	"bugs": "https://github.com/touchspot/prettier-config/issues",
	"repository": {
		"type": "git",
		"url": "https://github.com/touchspot/prettier-config.git"
	},
	"license": "MIT",
	"author": {
		"name": "mozisan",
		"email": "mozisan@users.noreply.github.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/default.d.ts",
			"default": "./dist/default.js"
		},
		"./tailwindcss": {
			"types": "./dist/tailwindcss.d.ts",
			"default": "./dist/tailwindcss.js"
		}
	},
	"files": [
		"dist",
		"package.json"
	],
	"scripts": {
		"build": "tsc",
		"check:format": "prettier --check .",
		"check:lint": "eslint .",
		"check:type": "tsc --noEmit",
		"check:unused": "knip",
		"fix:format": "prettier --write --log-level=warn .",
		"fix:lint": "eslint --fix .",
		"prepare": "husky"
	},
	"prettier": "./src/default.ts",
	"dependencies": {
		"eslint-plugin-better-tailwindcss": "^4.0.1",
		"prettier-plugin-packagejson": "^2.5.19",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"prettier-plugin-toml": "^2.0.6"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@commitlint/config-pnpm-scopes": "^20.1.0",
		"@commitlint/types": "^20.3.1",
		"@touchspot/eslint-config": "^3.0.3",
		"@tsconfig/node24": "^24.0.4",
		"@tsconfig/strictest": "^2.0.6",
		"@types/node": "^25.0.9",
		"commitizen": "^4.3.1",
		"cz-git": "^1.12.0",
		"eslint": "^9.38.0",
		"husky": "^9.1.7",
		"knip": "^5.66.2",
		"lint-staged": "^16.2.6",
		"prettier": "^3.6.2",
		"turbo": "^2.5.8",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"prettier": "^3.5.0"
	},
	"packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
	"publishConfig": {
		"access": "public"
	}
}
